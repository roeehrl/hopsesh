# The README demo. Recorded by demo/record.sh in containers with made-up machines.
Output "/demo/out/demo.gif"
Require hopsesh

Set Shell "bash"
Set Theme "Catppuccin Mocha"
Set FontSize 15
Set Width 1440
Set Height 600
Set Padding 24
Set WindowBar Colorful
Set TypingSpeed 70ms

Hide
Type "su - alice" Enter
Sleep 1s
Type "clear" Enter
Sleep 300ms
Show

Sleep 600ms
Type "hopsesh" Sleep 400ms Enter
Sleep 3.5s
Down Sleep 700ms
Down Sleep 700ms
Down Sleep 1.6s
Enter
Sleep 2.6s
Type "c" Sleep 1.2s
Type "r" Sleep 1.8s
Type "y"
Sleep 7s
