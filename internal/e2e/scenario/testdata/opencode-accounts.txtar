# OpenCode account folders (profiles). Each keeps its own data, state and config folders,
# so its own database and sign-ins. OpenCode's background service listens on one port, so
# hopsesh gives each folder it makes its own (decision D8), set through OpenCode's program
# with the folder's variables: the default folder's service, running here, is never
# stopped, started or moved. As for Claude Code and Codex, a session taken into another
# folder of this machine continues there as a new session (its portable conversation;
# the original stays), and a Claude Code session continues into one: both through
# OpenCode's own import, with the folder's variables, on a private server (the folder's
# own service is not running).
git-repo repo https://github.com/example/demo.git
claude-session 22222222-2222-4333-8444-555555555555 repo 'Account work' 'portable message in'
mkdir $HOME/.local/share/opencode
mkdir $HOME/.local/state/opencode
cp fake-service $HOME/.local/state/opencode/fake-service
exec opencode session import parent.json --directory $WORK/repo
stdout '^Imported session: ses_e29a40000ffeHandMadeImport$'
exec opencode session import child.json --directory $WORK/repo
stdout '^Imported session: ses_e29a3ffffffeHandMadeChild0$'

# A new folder for OpenCode: its own port, set in its own config folder.
exec hopsesh accounts add opencode 'Work' --json
stdout '"agent": "opencode"'
stdout '"port": [0-9]+'
! stdout '"port": 49374'
cp stdout work.json
account-id work.json
grep '^opencode service set port [0-9]+$' $WORK/agents.log
grep '^opencode service get port$' $WORK/agents.log
exists $HOME/.hopsesh/accounts/opencode/work/config/service.json
! grep 'stopped the background service' $WORK/agents.log

# A scan finds both folders (the default one registered as it is found); the new one
# has no session yet.
exec hopsesh ls --host local --agent opencode --json
stdout 'ses_e29a40000ffeHandMadeImport'
exec hopsesh accounts list --json
stdout '"name": "OpenCode default"'
stdout '"name": "Work"'
exec hopsesh accounts list
stdout 'its service on port [0-9]+'

# The session goes into the Work folder.
exec hopsesh pull opencode/ses_e29a40000ffeHandMadeImport --target-profile $ACCOUNT_ID --yes --json
stdout '"kind": "continue"'
stdout '"otherAccount": true'
cp stdout move.json
grep '^opencode session import .*accounts.opencode.work.data.opencode.hopsesh.opencode.tmp.* --standalone$' $WORK/agents.log
env XDG_DATA_HOME=$HOME/.hopsesh/accounts/opencode/work/data XDG_STATE_HOME=$HOME/.hopsesh/accounts/opencode/work/state OPENCODE_CONFIG_DIR=$HOME/.hopsesh/accounts/opencode/work/config
cd repo
exec opencode session list --format json --standalone
stdout 'imported by hand'
cd $WORK
env XDG_DATA_HOME= XDG_STATE_HOME= OPENCODE_CONFIG_DIR=
exec hopsesh ls --host local --agent opencode --json
stdout '"profile": "'$ACCOUNT_ID'"'

# A Claude Code session continues into the Work folder too.
exec hopsesh pull 22222222-2222-4333-8444-555555555555 --in opencode --target-profile $ACCOUNT_ID --yes --json
stdout '"kind": "continue"'
cp stdout cont.json
result-session cont.json
exec hopsesh ls --host local --agent opencode --json
stdout 'Account work'

# Undo deletes it through OpenCode, in the Work folder.
exec hopsesh undo --yes
grep -count=1 '^opencode session delete '$RETURN_ID' --standalone$' $WORK/agents.log
exec hopsesh ls --host local --agent opencode --json
! stdout 'Account work'
stdout 'imported by hand'

# Nothing started, stopped or moved the default folder's service, which ran all along.
exists $HOME/.local/state/opencode/fake-service
! grep 'started the background service' $WORK/agents.log
! grep 'stopped the background service' $WORK/agents.log

-- fake-service --
http://127.0.0.1:49374
