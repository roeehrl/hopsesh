# hopsesh lists and previews OpenCode's sessions from its database. The stand-in opencode
# keeps them in OpenCode 2.3.0's schema: a session imported through it, with a child
# (a subagent's session), as OpenCode's own import does.
git-repo repo https://github.com/example/demo.git
exec opencode session import parent.json --directory $WORK/repo --standalone
stdout '^Imported session: ses_e29a40000ffeHandMadeImport$'
exec opencode session import child.json --directory $WORK/repo --standalone
stdout '^Imported session: ses_e29a3ffffffeHandMadeChild0$'
# OpenCode's own list (of the folder's project) shows only the parent.
cd repo
exec opencode session list --format json --standalone
stdout '"id": "ses_e29a40000ffeHandMadeImport"'
! stdout 'HandMadeChild0'
cd $WORK

# The parent is listed, its child counted as a subagent, its size in messages.
exec hopsesh ls --host local --agent opencode --json
stdout '"id": "opencode"|"agent": "opencode"'
stdout '"title": "imported by hand"'
! stdout 'HandMadeChild0'
exec hopsesh ls --host local --agent opencode
stdout 'imported by hand'
stdout '4 messages'
! stdout 'imported child'
exec hopsesh show opencode/ses_e29a40000ffeHandMadeImport
stdout '^imported by hand$'
stdout 'agent +OpenCode 2.3.0'
stdout 'directory +.*repo'
stdout 'last prompt +“Check the repo and read main.go.”'
stdout 'size +4 messages, 1 subagent\(s\)'

# The preview reads the end of the conversation.
exec hopsesh-preview opencode/ses_e29a40000ffeHandMadeImport
stdout '^user: Check the repo and read main.go.$'
stdout '^agent: main.go is modified and missing.go does not exist.$'

# A rename goes through OpenCode's API, and OpenCode's list shows it.
exec hopsesh-rename opencode/ses_e29a40000ffeHandMadeImport 'Read main.go'
cd repo
exec opencode session list --format json --standalone
stdout '"title": "Read main.go"'
cd $WORK
grep '^opencode api --standalone PATCH /api/session/ses_e29a40000ffeHandMadeImport' $WORK/agents.log

# A move to another folder of this machine is a folder change (as hopsesh cd), which only
# OpenCode's running background service makes: with it stopped, hopsesh refuses before
# changing anything, and OpenCode still has the session, unchanged.
mkdir elsewhere
! exec hopsesh pull opencode/ses_e29a40000ffeHandMadeImport --to $WORK/elsewhere --yes
stderr 'cannot change the folder: OpenCode.s background service is not running'
stdout 'type /cd .*elsewhere in the session'
grep -count=2 '^opencode session import' $WORK/agents.log
! grep '^opencode session delete|^opencode api .*(DELETE|/move)' $WORK/agents.log
exec opencode session export ses_e29a40000ffeHandMadeImport --standalone
stdout '"directory": ".*repo"'

# hopsesh asked whether the background service runs, and never started it.
grep '^opencode service status' $WORK/agents.log
! grep 'started the background service' $WORK/agents.log
! exists $HOME/.local/state/opencode/fake-service

