# hopsesh moves an OpenCode session to another folder of this machine the way OpenCode's
# own /cd does: through OpenCode's running background service, which adds a
# location-switched message; hopsesh never writes OpenCode's database. Undo moves it back
# while the session is as the change left it, and refuses once it was used since.
env FAKE_OPENCODE_SERVICE=running
git-repo repo https://github.com/example/demo.git
exec opencode session import parent.json --directory $WORK/repo
stdout '^Imported session: ses_e29a40000ffeHandMadeImport$'
exec opencode session import child.json --directory $WORK/repo
stdout '^Imported session: ses_e29a3ffffffeHandMadeChild0$'
mkdir elsewhere

exec hopsesh cd opencode/ses_e29a40000ffeHandMadeImport $WORK/elsewhere --other-repo --yes
stdout 'location-switched'
grep '^opencode api POST /api/session/ses_e29a40000ffeHandMadeImport/move -d \{"directory":".*elsewhere"\}' $WORK/agents.log
! grep '^opencode api --standalone POST' $WORK/agents.log
exec opencode session export ses_e29a40000ffeHandMadeImport
stdout '"type": "location-switched"'
stdout '"directory": ".*elsewhere"'
exec hopsesh ls --host local --agent opencode --json
stdout '"cwd": ".*elsewhere"'

# Undo moves it back the same way.
exec hopsesh undo --yes
exec hopsesh ls --host local --agent opencode --json
stdout '"cwd": ".*repo"'
grep -count=2 '^opencode api POST /api/session/ses_e29a40000ffeHandMadeImport/move' $WORK/agents.log

# Moved again and used since (renamed in OpenCode): undo refuses and leaves it there.
exec hopsesh cd opencode/ses_e29a40000ffeHandMadeImport $WORK/elsewhere --other-repo --yes
exec opencode api PATCH /api/session/ses_e29a40000ffeHandMadeImport -d '{"title":"Read main.go elsewhere"}'
! exec hopsesh undo --yes
stderr 'continued after this|changed since'
exec hopsesh ls --host local --agent opencode --json
stdout '"cwd": ".*elsewhere"'

# Nothing ran on a private server, deleted or imported a session, or started the service
# (it ran all along).
! grep '^opencode (api|session) .*--standalone' $WORK/agents.log
! grep '^opencode session (delete|import) .*ses_e29a40000ffeHandMadeImport' $WORK/agents.log
! grep 'started the background service' $WORK/agents.log

