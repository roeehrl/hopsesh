# Unknown account continuity returns a new portable copy. The original is preserved.
# Undo refuses to discard later work, and forced undo removes only the new copy.
git-repo proj https://github.com/example/proj.git
claude-session 11111111-2222-4333-8444-555555555555 proj 'Fix the parser' 'please fix the parser in'

exec hopsesh pull 11111111-2222-4333-8444-555555555555 --in codex --yes
agent-turn codex * 'codex wrote the parser test'

exec hopsesh pull 'codex/Fix the parser' --in claude --yes --json
cp stdout return.json
result-session return.json
agent-turn claude $RETURN_ID 'claude continues from the test'
grep 'codex wrote the parser test' $SESSION

! exec hopsesh undo --yes
stderr 'changed since'
grep 'claude continues from the test' $SESSION

exec hopsesh undo --yes --force
! exists $SESSION
exec hopsesh ls --json --no-git
stdout '11111111-2222-4333-8444-555555555555'
! stdout 'claude continues from the test'
