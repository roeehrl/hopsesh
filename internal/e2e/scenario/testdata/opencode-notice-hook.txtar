# OpenCode's hopsesh plugin calls the notice hook with {"session_id","directory","event"}
# and reads one JSON verdict back: {"block":false} when there is nothing to say, so it can
# tell an answer from a hook that failed (which prints nothing). A session hopsesh
# continued elsewhere is blocked on any event, with hopsesh's reason (OpenCode cannot
# refuse a prompt, so the plugin refuses its tool calls). Malformed calls fail open and
# print nothing, and nothing runs OpenCode.
git-repo proj https://github.com/example/proj.git
mkdir $HOME/.local/share/opencode
exec opencode session import a.json --directory $WORK/proj --standalone
stdout '^Imported session: ses_e29a40000ffeProtectedOrig0$'

stdin prompt.json
exec hopsesh notice-hook --agent opencode --profile ''
stdout '^\{"block":false\}$'
! stderr .
stdin start.json
exec hopsesh notice-hook --agent opencode
stdout '^\{"block":false\}$'

# Only the plugin's calls are answered: Claude Code's JSON, a bad session, an event the
# plugin never sends or a folder too long to be one fail open, silently.
stdin claude.json
exec hopsesh notice-hook --agent opencode
! stdout .
! stderr .
stdin malformed.json
exec hopsesh notice-hook --agent opencode
! stdout .
stdin missing-session.json
exec hopsesh notice-hook --agent opencode
! stdout .
stdin invalid-session.json
exec hopsesh notice-hook --agent opencode
! stdout .
stdin wrong-event.json
exec hopsesh notice-hook --agent opencode
! stdout .
stdin long-directory.json
exec hopsesh notice-hook --agent opencode
! stdout .

# Continued in Claude Code, the OpenCode session is the stale original: blocked, with
# the reason the plugin shows for every refused tool call, on a prompt and on the events
# after which a copy may have moved.
exec hopsesh pull opencode/ses_e29a40000ffeProtectedOrig0 --in claude --yes --json
stdout '"kind": "continue"'
stdin prompt.json
exec hopsesh notice-hook --agent opencode --profile ''
stdout '^\{"block":true,"reason":"Blocked by hopsesh\. .*Claude Code.*hopsesh unblock ses_e29a40000ffeProtectedOrig0'
! stdout context
stdin start.json
exec hopsesh notice-hook --agent opencode --profile ''
stdout '^\{"block":true,"reason":"Blocked by hopsesh\. '

# Unblocked by the user: no verdict against it, but the notice that it moved.
exec hopsesh unblock opencode/ses_e29a40000ffeProtectedOrig0 --yes
stdin prompt.json
exec hopsesh notice-hook --agent opencode --profile ''
stdout '^\{"block":false'
! stdout '"block":true'

! grep '^opencode (run|api)' $WORK/agents.log

-- prompt.json --
{"session_id":"ses_e29a40000ffeProtectedOrig0","directory":"/home/u/git/proj","event":"UserPromptSubmit"}
-- start.json --
{"session_id":"ses_e29a40000ffeProtectedOrig0","directory":"/home/u/git/proj","event":"SessionStart"}
-- claude.json --
{"hook_event_name":"UserPromptSubmit","session_id":"ses_e29a40000ffeProtectedOrig0","transcript_path":"/home/u/x.jsonl"}
-- malformed.json --
{"session_id":
-- missing-session.json --
{"event":"UserPromptSubmit","directory":"/home/u"}
-- invalid-session.json --
{"session_id":"ses_bad\u0000id","event":"UserPromptSubmit"}
-- wrong-event.json --
{"session_id":"ses_e29a40000ffeProtectedOrig0","event":"PreToolUse"}
-- long-directory.json --
{"session_id":"ses_e29a40000ffeProtectedOrig0","event":"UserPromptSubmit","directory":""}
