# Decision D2: OpenCode's background service is shared by every OpenCode window and the
# desktop app. When it runs another version than every opencode program here (no desktop
# app here ships 2.2.5), opening a session would restart it: hopsesh does not open it
# unasked, says how to agree, and opens it once the person agrees (--restart-service).
env FAKE_OPENCODE_SERVICE=running
env FAKE_OPENCODE_SERVICE_VERSION=2.2.5
git-repo repo https://github.com/example/demo.git
exec opencode session import parent.json --directory $WORK/repo
stdout '^Imported session: ses_e29a40000ffeHandMadeImport$'

! exec hopsesh open opencode/ses_e29a40000ffeHandMadeImport --here
stderr 'background service runs 2\.2\.5'
stderr 'restart the service'
stderr 'run again with --restart-service'
! grep 'replaced the background service' $WORK/agents.log
! grep '^opencode -s' $WORK/agents.log

exec hopsesh open opencode/ses_e29a40000ffeHandMadeImport --here --restart-service
stdout 'would open ses_e29a40000ffeHandMadeImport'
grep 'opencode: replaced the background service 2\.2\.5 with 2\.3\.0' $WORK/agents.log

